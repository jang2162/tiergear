{
  "name": "tiergear",
  "version": "0.1.0",
  "description": "Let a decision model pick the model and reasoning effort for Claude Code sessions and Orca workers",
  "type": "module",
  "license": "MIT",
  "author": "jang2162",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jang2162/tiergear.git"
  },
  "homepage": "https://github.com/jang2162/tiergear#readme",
  "bugs": "https://github.com/jang2162/tiergear/issues",
  "keywords": ["claude-code", "claude", "plugin", "reasoning-effort", "model-routing", "orca"],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "tiergear": "dist/cli/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
